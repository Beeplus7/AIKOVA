# AiKOVA — Environment Credentials
# Copy to .env and fill in values.
# Do not commit .env.
# Client-safe values use the EXPO_PUBLIC_ prefix.

# --- Supabase ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=

# --- Google OAuth (paste into Supabase Auth → Providers → Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# --- GitHub (repo / CI / deploy) ---
GITHUB_TOKEN=
GITHUB_OWNER=Beeplus7
GITHUB_REPO=AIKOVA
GITHUB_WEBHOOK_SECRET=

# --- VPS / Deploy ---
VPS_HOST=
VPS_USER=root
VPS_SSH_PORT=22
VPS_DEPLOY_PATH=/var/www/aikova
VPS_SSH_KEY_PATH=
EXPO_PUBLIC_API_BASE_URL=https://aikova.co.uk
EXPO_PUBLIC_APP_URL=https://aikova.co.uk
CRM_API_PORT=3015
CRM_ALLOW_ANON=0
CRM_CORS_ORIGINS=https://aikova.co.uk,http://localhost:8081
ADMIN_CLAIM_SECRET=
